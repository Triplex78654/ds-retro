{
  "name": "retro-app",
  "productName": "Rétro",
  "version": "0.6.1",
  "description": "Rétro : toutes tes consoles dans une seule appli, avec ton cloud et tes potes",
  "author": "Triplex78654",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "main.js",
  "scripts": {
    "preparer": "node preparer.mjs",
    "demarrer": "npm run preparer && electron .",
    "construire": "npm run preparer && electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.triplex78654.retro",
    "productName": "Rétro",
    "files": [
      "main.js",
      "serveur-local.js",
      "preload.js",
      "site/**/*",
      "package.json",
      "emulateurs.js",
      "maj.js",
      "azahar.js",
      "recherche.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icone.png",
      "executableName": "Retro"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Rétro",
      "artifactName": "Retro-${version}-installation.${ext}"
    },
    "portable": {
      "artifactName": "Retro-${version}-portable.exe"
    },
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Triplex78654/ds-retro/releases/latest/download"
      }
    ]
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-updater": "^6.8.11"
  }
}
